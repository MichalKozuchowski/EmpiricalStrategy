# --- Data (never commit raw/large datasets) ---
data/*
!data/.gitkeep
*.csv
*.tsv
*.parquet
*.xlsx
*.json
!**/small_examples/*.json

# HW0 source files are small (<1MB) and are the assignment input itself — keep them
!hw0/data/*.csv
!hw0/data/*.pdf

# --- Python ---
__pycache__/
*.py[cod]
*.ipynb_checkpoints/
.ipynb_checkpoints
venv/
.venv/
env/
*.egg-info/
.pytest_cache/

# --- Jupyter ---
.ipynb_checkpoints

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
*.swp

# --- Secrets ---
.env
*.key
